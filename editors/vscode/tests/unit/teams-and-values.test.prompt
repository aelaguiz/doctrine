# SYNTAX TEST "source.doctrine" "teams, values, and late roots"

team Core: "Core"
# <- keyword.control.doctrine
#    ^^^^ entity.name.type.doctrine
    home: "teams/core"
#   ^^^^ keyword.other.field.doctrine
    values:
#   ^^^^^^ keyword.other.field.doctrine
        unit: "change"
    member qa[Tester]: "QA"
#   ^^^^^^ keyword.control.doctrine
#          ^^ entity.name.type.doctrine
        role: "{{agent:unit}} {{team:title}}"
#                ^^^^^ variable.language.doctrine
#                      ^^^^ variable.other.member.doctrine
#                               ^^^^ variable.language.doctrine
#                                    ^^^^^ variable.other.member.doctrine
    work: "Work"
        roster calls: "Calls"
#       ^^^^^^ keyword.control.doctrine
#              ^^^^^ entity.name.section.doctrine
            who: "Who" = "{{agent:title}}"

abstract agent Craft from "craft.md"
#                    ^^^^ keyword.control.doctrine
workflow Shared from "shared.md"
#               ^^^^ keyword.control.doctrine
