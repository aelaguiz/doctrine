direction: down

overview: {
  label: "Rally WSAPI Object Map"
  direction: right
  style: {
    fill: "#F8FAFC"
    stroke: "#94A3B8"
  }

  coverage_note: {
    label: "Coverage\nBased on Broadcom article 113749.\nThat source says the list may not be exhaustive."
    shape: rectangle
    style: {
      fill: "#F8FAFC"
      stroke: "#94A3B8"
    }
  }

  reading_guide: {
    label: "Reading Guide\nBlue solid edges = documented inheritance.\nOrange cards = work and planning families.\nGreen cards = testing and delivery families.\nGray cards = schema, admin, and access families."
    shape: rectangle
    style: {
      fill: "#F8FAFC"
      stroke: "#94A3B8"
    }
  }
}

