abstract agent Waiter:
    role: "You wait well."
    when: "When to wait"
        details:
            "The {{agent:unit}} waited."
        details common: "A shared case"
            "Wait for the result."

team GrowthPod: "the growth pod"
    home: "pods/growth"
    values:
        unit: "bet"
    member qa[Waiter]: "QA"

team FeaturePod: "the feature pod"
    home: "pods/feature"
    values:
        unit: "feature"
    member qa[Waiter]: "QA"
