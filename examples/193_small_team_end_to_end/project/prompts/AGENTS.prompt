# One small team, start to finish: shared roles, shared words, thin homes,
# checked reach, attributed words, and one message declared once.

person Owner: "The owner"
    owns:
        Numbers


abstract agent Member:
    role: "Help the team ship its work."


workflow Numbers: "Numbers"
    "Get every number the canonical way."


team Root: "the repository"
    home: "."
    numbers: Numbers


abstract agent Qa[Member]:
    values:
        calls: "Whether a change passes its testing"
    whom: "Whom you work with"
        "You follow the {{agent:unit}} from the design on."
        details:
            "The first test plan on this team missed a state nobody had named."
    inherit *


abstract agent Lead[Member]:
    values:
        calls: "Which {{agent:unit}} to take"
    outputs: "Outputs"
        CodeReady
    inherit *


output CodeReady: "Code is ready"
    target: Message
        to: "the release lead"
    "One message when the code is ready."
    bullets carries: "It carries"
        "The pull requests that go out together"
        "What users get from them"


abstract team Pod:
    who: "Who makes each call"
        "Members: {{team:members}}."
        roster calls: "The calls"
            call: "The call" = "{{agent:calls}}"
            who: "Who makes it" = "{{agent:title}}"
    member lead[Lead]: "lead"
    member qa[Qa]: "QA"


team GrowthPod[Pod]: "the growth pod"
    home: "pods/growth"
    values:
        unit: "bet"


team FeaturePod[Pod]: "the feature pod"
    home: "pods/feature"
    values:
        unit: "feature"


rule EveryMemberLoadsNumbers: "Every member loads the numbers rule"
    scope:
        team: *
    assertions:
        requires load Numbers
    message: "A rule meant for every agent reaches every agent."
